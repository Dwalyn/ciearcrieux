{% extends 'base.html.twig' %}

{% block title_page %}
    {{ parent() }} - {{ 'menu.news'|trans }}
{% endblock %}

{% block content %}
    <div class="w-75">
        <div class="d-flex justify-content-between align-middle bd-highlight mb-3">
            <div>
            </div>
            <div class="mt-2">
                <a href="{{ path('actuality') }}"> <i class="fa-solid fa-arrow-left"></i>
                    {{ 'button.back'|trans }}</a>
            </div>
        </div>
        <twig:PostComponent
                post="{{ post }}"
        />
    </div>
{% endblock %}
