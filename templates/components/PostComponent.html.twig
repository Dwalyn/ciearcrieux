<div class="row g-0 border rounded overflow-hidden mb-4 h-md-250 position-relative">
    <div class="col p-4 d-flex flex-column position-static">
        <h4>{{ post.title }}</h4>
        <div class="d-flex justify-content-between">
            <div class="d-flex fw-semibold">{{ post.postDate|date('d/m/Y') }} - {{ post.location }}</div>
            <div class="d-flex">
                <span class="badge bg-primary">{{ post.postTypeEnum.translationKey|trans }}</span>
            </div>
        </div>
        <div class="card-text mb-auto mt-4">
            {% if this.hasTruncateDescription %}
                {{ this.truncateDescription|raw }}
            {% else %}
                {{ post.description|raw }}
            {% endif %}
        </div>
        {% block link %}
        {% endblock %}
    </div>
</div>
