<div>
    {% for post in this.listPost %}
        <twig:PostComponent
                post="{{ post }}"
                hasTruncateDescription="true"
        >
            <twig:block name="link">
                <div class="text-end">
                    <a class="stretched-link" href="{{ path('actuality_show', {id: post.id}) }}">{{ 'global.link.details'|trans }} <i class="fa-solid fa-arrow-right"></i></a>
                </div>
            </twig:block>
        </twig:PostComponent>

    {% endfor %}
</div>
{% if this.showPaginator %}
    <div class="d-flex justify-content-center">
        {{ knp_pagination_render(this.listPost) }}
    </div>
{% endif %}
