{% extends 'base.html.twig' %}

{% block title_page %}
    {{ parent() }} - {{ 'menu.news'|trans }}
{% endblock %}

{% block h1 %} {{ 'menu.news'|trans }} {% endblock %}

{% block content %}
    {{ form_start(form) }}
    <div class="form-group mb-2">
        <label for="quill-editor-container">Contenu</label>
        <div id="quill-editor-container" data-quill-editor="{{ form.content.vars.id }}" style="height: 300px; background-color: white;"></div>
        {{ form_row(form.content) }}
    </div>
    <div>
        <button type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i> {{ 'button.save'|trans }}</button>
        <a href="{{ path('admin_postsList') }}" class="btn btn-outline-secondary">{{ 'button.cancel'|trans }}</a>
    </div>
    {{ form_end(form) }}
{% endblock %}
