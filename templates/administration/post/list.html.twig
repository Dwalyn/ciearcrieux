{% extends 'base.html.twig' %}

{% block title_page %}
    {{ parent() }} - {{ 'menu.news'|trans }}
{% endblock %}

{% block h1 %} {{ 'menu.news'|trans }} {% endblock %}

{% block content %}
    <div class="w-75">
        <div class="d-flex mb-4">
            <div>
                <a href="{{ path('admin_postAdd') }}" type="button" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> {{ 'button.add'|trans }}
                </a>
            </div>
        </div>
        <twig:Administration:Actuality:ListPostComponent
                showPaginator="true"
                page="{{ page }}"
        >
            <twig:block name="link">
                <div class="text-end">
                    <a class="stretched-link" href="{{ path('actuality_show', {id: post.id}) }}">{{ 'global.link.details'|trans }} <i class="fa-solid fa-arrow-right"></i></a>
                </div>
            </twig:block>
        </twig:Administration:Actuality:ListPostComponent>
    </div>
{% endblock %}
